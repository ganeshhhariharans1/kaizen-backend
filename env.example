# ─────────────────────────────────────────
#  Kaizen Studio India — Environment Config
# ─────────────────────────────────────────

# Server
PORT=3000

# Total client slots per month
TOTAL_SLOTS=20

# CORS — restrict to your actual domain in production
# ALLOWED_ORIGIN=https://kaizenstudio.india

# Admin dashboard secret key (set any strong random string)
ADMIN_KEY=change-this-to-a-strong-secret

# Email — Gmail recommended
# 1. Use your Gmail address
# 2. For EMAIL_PASS, generate an App Password:
#    Google Account → Security → 2-Step Verification → App Passwords
EMAIL_SERVICE=gmail
EMAIL_USER=ganeshhariharan.s8@gmail.com
EMAIL_PASS=your-gmail-app-password-here

# Where to send owner notifications (defaults to EMAIL_USER if not set)
OWNER_EMAIL=ganeshhariharan.s8@gmail.com
